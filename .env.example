# Olo AI — Environment Configuration Template
# Copy this file to .env and fill in your values. Never commit .env.

# ── Application ──────────────────────────────────────────────
APP_ENV=
APP_SECRET_KEY=

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=

# ── Authentication ───────────────────────────────────────────
AUTH_SECRET=

# ── AI / LLM Providers ───────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── External Services ────────────────────────────────────────
# Add third-party API keys and service URLs here
