# Olo M3 — Hindsight Option B runtime configuration template (per business).
#
# This template records what a production Option B instance requires.
# Copy to $BUSINESS_HOME/.env, chmod 600. NEVER commit a file with real values.
# API key is injected via Hermes secret scope at startup.
#
# Every variable here has been validated against Hindsight v1.2.1
# commit 0eb02d8c418eac6b489bc63883c993b2257dfac4 config.py.
# See olo/m3/tests/test_m3_config.py for the automated validity check.
#
# Opus audit corrections applied:
#   - Removed DATABASE_DATA_DIR (not a valid v1.2.1 var; silently ignored)
#   - Removed DEFAULT_BANK_ID (not a valid v1.2.1 var; silently ignored)
#   - Removed EMBED_PROVIDER (not valid; correct: EMBEDDINGS_PROVIDER)
#   - Removed EMBEDDINGS_BASE_URL (not valid; correct: EMBEDDINGS_OPENAI_BASE_URL)
#   - Removed TELEMETRY_ENABLED, CLOUD_ENABLED, WEBHOOKS_ENABLED (none exist)
#   - Removed DeepSeek embedding block (would send LLM key to wrong host)
#   - Set EMBEDDINGS_PROVIDER=onnx with pinned model (local, no network egress)
#   - Set RERANKER_PROVIDER=rrf (confirmed valid in cross_encoder.py)
#   - Telemetry controlled via standard OTEL_SDK_DISABLED, not Hindsight vars

# ── Database (per-business named pg0 instance) ───────────────────────────────
# Format: pg0://olo-<BUSINESS_ID>
# pg0 stores data at $HOME/.pg0/olo-<BUSINESS_ID>/ using the process HOME.
# Run with HOME set to the business-specific directory for isolation (§B.9).
HINDSIGHT_API_DATABASE_URL=pg0://olo-${BUSINESS_ID}

# ── Network (loopback only, §B.9) ────────────────────────────────────────────
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=${PORT}

# ── LLM: DeepSeek via native provider (Option B, BBC approved) ───────────────
HINDSIGHT_API_LLM_PROVIDER=deepseek
# API key injected by Hermes secret scope — not stored here:
# HINDSIGHT_API_LLM_API_KEY=sk-...
HINDSIGHT_API_LLM_MODEL=deepseek-chat
HINDSIGHT_API_LLM_STRICT_SCHEMA=false

# ── Embeddings: ONNX local CPU, pinned model, no network egress ──────────────
# HINDSIGHT_API_EMBEDDINGS_PROVIDER is the correct v1.2.1 var.
# Using ONNX with the multilingual-e5-small model (384 dimensions).
# No DeepSeek key involved — this is a local CPU model.
# The DeepSeek embedding block was removed from previous config because
# EMBEDDINGS_BASE_URL is NOT a valid v1.2.1 var (correct: EMBEDDINGS_OPENAI_BASE_URL),
# and DeepSeek does not offer text-embedding-3-small.
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_EMBEDDINGS_ONNX_MODEL_ID=intfloat/multilingual-e5-small
# 384 dimensions (confirmed from actual server startup log)
HINDSIGHT_API_EMBEDDINGS_ONNX_CPU_MEM_ARENA=false

# ── Reranker: RRF (pure algorithmic, no model needed) ────────────────────────
HINDSIGHT_API_RERANKER_PROVIDER=rrf

# ── Decision model: none (Olo calls Jev directly, §B.2) ──────────────────────
HINDSIGHT_API_DECISION_MODEL_PROVIDER=none

# ── MCP: disabled (HINDSIGHT_API_MCP_ENABLED is a valid v1.2.1 var) ─────────
HINDSIGHT_API_MCP_ENABLED=false

# ── Document text retention (needed for rebuild, §B.10) ──────────────────────
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true

# ── LLM trace: off (audit in Olo's model_calls table, §B.3) ─────────────────
HINDSIGHT_API_LLM_TRACE_ENABLED=false

# ── Cost guard: low concurrency to stay within budget ────────────────────────
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_REFLECT_LLM_MAX_CONCURRENT=1

# ── Telemetry: disabled via standard OTEL env var ────────────────────────────
# HINDSIGHT_API_TELEMETRY_ENABLED does NOT exist in v1.2.1; using OTEL standard.
OTEL_SDK_DISABLED=true
