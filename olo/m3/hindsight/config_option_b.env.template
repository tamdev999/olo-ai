# Olo M3 — Hindsight Option B configuration template (per business).
# Copy to $HERMES_HOME/olo/hindsight/data/<business_id>/.env
# chmod 600. NEVER commit this file.
# API key injected by Hermes secret scope at startup — not stored here.
#
# Opus architecture: §B.2, revised spec §4 (Option B).
# Hindsight v1.2.1 / commit 0eb02d8c418e

# ── Database (embedded Postgres, per business) ───────────────────────────────
HINDSIGHT_API_DATABASE_URL=pg0
HINDSIGHT_API_DATABASE_DATA_DIR=${DATA_DIR}/pg0

# ── Network (loopback only, §B.9) ────────────────────────────────────────────
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=${PORT}

# ── LLM: DeepSeek via native provider (Option B, BBC approved) ───────────────
HINDSIGHT_API_LLM_PROVIDER=deepseek
HINDSIGHT_API_LLM_API_KEY=${HINDSIGHT_API_LLM_API_KEY}
# Default model: deepseek-v4-flash (from PROVIDER_DEFAULT_MODELS in config.py)
# Explicit pin to avoid drift if the default changes:
HINDSIGHT_API_LLM_MODEL=deepseek-chat

# Structured output: DeepSeek supports response_format=json_object
HINDSIGHT_API_LLM_STRICT_SCHEMA=false

# ── Embeddings: OpenAI-compatible via DeepSeek API ──────────────────────────
# DeepSeek exposes an OpenAI-compatible embedding endpoint.
# Model: text-embedding-v3 (DeepSeek's embedding model as of v1.2.1 era)
HINDSIGHT_API_EMBEDDINGS_PROVIDER=openai-compatible
HINDSIGHT_API_EMBEDDINGS_OPENAI_API_KEY=${HINDSIGHT_API_LLM_API_KEY}
HINDSIGHT_API_EMBEDDINGS_OPENAI_MODEL=text-embedding-3-small
# Point to DeepSeek's OpenAI-compatible base URL:
HINDSIGHT_API_EMBEDDINGS_BASE_URL=https://api.deepseek.com/v1

# ── Decision model: none (Olo calls Jev directly, §B.2) ──────────────────────
HINDSIGHT_API_DECISION_MODEL_PROVIDER=none

# ── Isolation: telemetry, MCP, cloud, webhooks all off (§B.9) ────────────────
HINDSIGHT_API_TELEMETRY_ENABLED=false
HINDSIGHT_API_MCP_ENABLED=false
HINDSIGHT_API_CLOUD_ENABLED=false
HINDSIGHT_API_WEBHOOKS_ENABLED=false

# ── Memory features (Option B: intelligence on) ───────────────────────────────
# Consolidation ON: observations with version history, contradiction handling
# Mental models ON: hot context per entity, cron refresh
# Reflect ON: temporal + entity reasoning
HINDSIGHT_API_STORE_DOCUMENT_TEXT=true

# ── LLM trace: off (audit in Olo's model_calls table, §B.3) ─────────────────
HINDSIGHT_API_LLM_TRACE_ENABLED=false

# ── Cost guard: cap spend to stay within $10 test budget ─────────────────────
# deepseek-chat: $0.14 input / $0.28 output per 1M tokens (non-cache)
# 10 LLM calls max per batch for the PoC
HINDSIGHT_API_RETAIN_LLM_MAX_CONCURRENT=2
HINDSIGHT_API_CONSOLIDATION_LLM_MAX_CONCURRENT=2
